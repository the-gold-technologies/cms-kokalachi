    "next-auth": "^5.0.0-beta.30",
    "nodemailer": "^7.0.13",
    "pg": "^8.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hot-toast": "^2.6.0",
    "react-quill-new": "^3.8.3",
    "sharp": "^0.35.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
